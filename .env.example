# Copy to .env.local and fill in. B1 reads the app values below; Airwallex keys are used by the spike and from B2.
# cp .env.example .env.local

# --- Public (available in the browser) ---
# UI uses the in-memory mock transport instead of /api/*. Refused in production
# unless ALLOW_MOCKS_IN_PROD=true.
NEXT_PUBLIC_API_MOCKS=true
# Expose /dev/ui-kit in production builds. Always on in development.
NEXT_PUBLIC_ENABLE_UI_KIT=false
# Airwallex.js init({ env }). demo = sandbox.
NEXT_PUBLIC_AIRWALLEX_ENV=demo

# Explicit opt-in for a mock-backed UI preview deployment.
ALLOW_MOCKS_IN_PROD=false

# --- App ---
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/awx-marketplace
# 32+ random characters. Signs the session JWT.
SESSION_SECRET=replace-with-32-plus-random-chars

# --- Airwallex (server only) ---
AIRWALLEX_API_BASE=https://api.sandbox.airwallex.com
AIRWALLEX_CLIENT_ID=
# Secret. x-api-key for login. Never expose to the client.
AIRWALLEX_API_KEY=
# Secret. HMAC key for the x-signature webhook header.
AIRWALLEX_WEBHOOK_SECRET=
# DEMO-ONLY: accept sandbox web-app test events signed with the client-secret-key header.
# Off by default. Ignored when NODE_ENV=production. PROD: leave unset.
# AIRWALLEX_ALLOW_WEBHOOK_TEST_SIGNATURES=true
AIRWALLEX_PLATFORM_ACCOUNT_ID=
# Optional. Spike 01 compares calls with and without this header. Latest documented version is 2026-08-21.
# Leave unset until that spike result is accepted.
# AIRWALLEX_API_VERSION=

# --- Demo config ---
DEMO_CURRENCY=USD
PLATFORM_FEE_PERCENT=10
PROCESSING_RESERVE_PERCENT=2
WELCOME_CREDIT_AMOUNT=5000
ENABLE_WALLET_RAIL=true
# When true, a seller can deliver a milestone only after the previous one is paid.
SEQUENTIAL_MILESTONES=false
SEED_PASSWORD=demo1234
# When set, /platform and its APIs require this key. Leave empty to leave the page open to any signed-in user.
DEMO_ADMIN_KEY=
